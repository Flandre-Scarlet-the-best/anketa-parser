<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- Источник данных об уязвимостях задан явно: без него предупреждение NU1905
       о недоступной vulnerability data может быть подавлено, и пустой аудит
       выглядел бы успешным. Пакеты по-прежнему загружаются только из nuget.org. -->
  <auditSources>
    <clear />
    <add key="nuget.org-vulnerabilities" value="https://data.nuget.org/v3/index.json" />
  </auditSources>
</configuration>