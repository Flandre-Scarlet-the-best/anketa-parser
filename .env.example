# Публичный пример локальной конфигурации для Docker Compose.
# Скопируйте файл в .env (он исключён из Git) и задайте собственный пароль.
# Настоящие секреты (токены Telegram, ключи LLM) в этот файл и в репозиторий не добавляются.

POSTGRES_DB=anketa_parser
POSTGRES_USER=anketa_parser
POSTGRES_PASSWORD=replace-with-a-local-password

# Логическое имя экземпляра, попадающее в логи и диагностику.
ANKETAPARSER_INSTANCE_NAME=anketa-parser

# Окружение хоста: Production | Development
DOTNET_ENVIRONMENT=Production

# Порог loopback-публикации PostgreSQL для локальной отладки (compose.debug.yaml).
ANKETAPARSER_DB_DEBUG_PORT=55432
