{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "AnketaParser": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": false
      }
    }
  },
  "Host": {
    "InstanceName": "anketa-parser",
    "ShutdownTimeoutSeconds": 20,
    "StartupDiagnosticsEnabled": true,
    "ReadinessCheckIntervalSeconds": 0
  },
  "Database": {
    "ConnectionString": "",
    "Required": false,
    "ConnectTimeoutSeconds": 5,
    "CommandTimeoutSeconds": 5
  },
  "Diagnostics": {
    "ProbeTimeoutSeconds": 5
  }
}
